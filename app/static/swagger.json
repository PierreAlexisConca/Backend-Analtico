{
    "swagger": "2.0",
    "info": {
        "title": "Backend Analítico API",
        "description": "Servicios analíticos empresariales desarrollados con Flask, MongoDB y SQL Server mediante arquitectura por capas.",
        "version": "1.0"
    },
    "host": "127.0.0.1:5000",
    "basePath": "/",
    "schemes": [
        "http"
    ],
    "paths": {
        "/": {
            "get": {
                "summary": "Verificar estado del Backend",
                "description": "Permite validar que la API está funcionando correctamente.",
                "responses": {
                    "200": {
                        "description": "Backend operativo"
                    }
                }
            }
        },
        "/analytics/sales-total": {
            "get": {
                "tags": [
                    "Indicadores SQL Server"
                ],
                "summary": "Obtener ventas totales",
                "description": "Calcula las ventas totales. Permite filtrar por año y mes. Si solo se envía el mes, consulta ese mes de todos los años.",
                "parameters": [
                    {
                        "name": "year",
                        "in": "query",
                        "description": "Año de las ventas. El Backend valida que sea un número entero válido.",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "name": "month",
                        "in": "query",
                        "description": "Mes de las ventas. El Backend valida que esté entre 1 y 12.",
                        "required": false,
                        "type": "integer"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ventas totales calculadas correctamente",
                        "schema": {
                            "$ref": "#/definitions/IndicatorResponse"
                        }
                    },
                    "400": {
                        "description": "Parámetros inválidos"
                    },
                    "500": {
                        "description": "Error interno del servidor"
                    }
                }
            }
        }
    },
    "definitions": {
        "IndicatorResponse": {
            "type": "object",
            "properties": {
                "indicator": {
                    "type": "string",
                    "description": "Identificador único del indicador"
                },
                "title": {
                    "type": "string",
                    "description": "Título descriptivo del indicador"
                },
                "chart_type": {
                    "type": "string",
                    "description": "Tipo de gráfico recomendado (card, bar, line, pie)"
                },
                "data": {
                    "type": "number",
                    "description": "Valor numérico del indicador"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Fuentes de datos utilizadas"
                }
            }
        }
    }
}
